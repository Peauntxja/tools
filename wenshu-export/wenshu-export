#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

ensure_node() {
  if command -v fnm >/dev/null 2>&1; then
    eval "$(fnm env -s bash 2>/dev/null || fnm env -s zsh 2>/dev/null || true)"
    if fnm list 2>/dev/null | rg -q 'v20\.|v22\.|v24\.'; then
      fnm use 20 >/dev/null 2>&1 || fnm use 22 >/dev/null 2>&1 || fnm use 24 >/dev/null 2>&1 || true
    fi
  fi

  if ! command -v node >/dev/null 2>&1; then
    echo "错误: 未找到 node。请安装 Node.js 18+。" >&2
    exit 1
  fi

  local major
  major="$(node -p "process.versions.node.split('.')[0]")"
  if [[ "$major" -lt 18 ]]; then
    echo "错误: 需要 Node.js 18+，当前: $(node -v)" >&2
    echo "提示: 可安装 fnm 后执行 fnm install 20 && fnm use 20" >&2
    exit 1
  fi
}

ensure_node

if [[ ! -d node_modules ]]; then
  echo "首次运行，正在安装依赖..."
  npm install --silent
fi

exec node lib/export.js "$@"
